      "node": "./src/index.js",
      "default": "./src/index.ts"
    },
    "./messages": {
      "types": "./src/messages.ts",
      "browser": "./src/messages.ts",
      "node": "./src/messages.js",
      "default": "./src/messages.ts"
    },
    "./store": {
      "types": "./src/store.ts",
      "browser": "./src/store.ts",
      "node": "./src/store.js",
      "default": "./src/store.ts"
    },
    "./client-read": {
      "types": "./src/client-read.ts",
      "browser": "./src/client-read.ts",
      "node": "./src/client-read.js",
      "default": "./src/client-read.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  }
