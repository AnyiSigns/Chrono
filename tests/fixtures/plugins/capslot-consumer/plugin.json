{
  "identity": "capslot-consumer",
  "implements": [],
  "methods": {},
  "needs": {
    "capslot.single": { "mode": "one" },
    "capslot.many": { "mode": "many", "methods": ["collect"] }
  },
  "start": "",
  "build": [],
  "protocol": "1",
  "restart": {
    "policy": "never",
    "backoff": "none",
    "max": 0,
    "window_ms": 60000,
    "drain_ms": 500
  },
  "health": {
    "interval_ms": 10000,
    "timeout_ms": 1000
  },
  "state": "recomputable",
  "members": [
    { "kind": "term", "path": "terms/" }
  ],
  "commands": [
    { "name": "capslot.echo-one", "entry": "terms/capslot.echo-one.json" },
    { "name": "capslot.collect-many", "entry": "terms/capslot.collect-many.json" }
  ]
}
