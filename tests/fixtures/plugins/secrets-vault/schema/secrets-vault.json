{
  "title": "secrets-vault（测试夹具密钥后端）",
  "description": "测试夹具：secrets-backend 扩展类的提供方，kinds = [vault]，回固定引用名与明文。仅用于证明扩展点零改动链路，不是生产后端。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "read_request": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "read_result": { "type": "string" },
    "backend_kinds": {
      "type": "array",
      "items": { "type": "string", "const": "vault" }
    }
  }
}
