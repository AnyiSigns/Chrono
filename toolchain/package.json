{
  "name": "toolchain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "term 作者工具链（构建期，非运行时）",
  "files": [
    "package.json",
    "README.md",
    "tsconfig.json",
    "spec.md",
    "lower.ts",
    "builder.ts",
    "validate.ts",
    "testkit.ts",
    "sourcemap.ts",
    "build.ts"
  ],
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
