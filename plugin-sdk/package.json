{
  "name": "plugin-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "插件服务 SDK：服务协议帧编解码 / 帧循环 / manifest 派生 / 调用派发 / 反向调用通道（插件侧库，零内核零宿主依赖）",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "package.json",
    "README.md",
    "tsconfig.json",
    "index.ts",
    "canonical.ts",
    "driver.ts",
    "env.ts",
    "json.ts",
    "manifest.ts",
    "plan.ts",
    "port-link.ts",
    "service.ts",
    "types.ts",
    "wire.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
