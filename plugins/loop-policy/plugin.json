{
  "identity": "loop-policy",
  "schema": "schema/graph.json",
  "implements": ["loop-policy"],
  "methods": {
    "loop-policy": ["interpret"]
  },
  "pins": {
    "session": "session",
    "model": "model-protocol",
    "context": "context-window",
    "retrieval": "memory-retrieval",
    "guard": "guard",
    "approval": "approval",
    "tools": "tools",
    "router": "router",
    "evolve-metrics": "evolve-metrics",
    "host": "host"
  },
  "start": "node execute/main.ts",
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "probe": "loop-policy.interpret",
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "recomputable",
  "members": [
    { "kind": "execute", "path": "execute/" },
    { "kind": "schema", "path": "schema/" }
  ],
  "commands": []
}
