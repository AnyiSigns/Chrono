{
  "version": 1,
  "bindings": {
    "memory.compress": {
      "class": "compress",
      "method": "summarize",
      "intent": "把本回合的结构化结论压成一段更短的 L1 摘要。",
      "when_to_use": "上下文接近预算上限、需要压缩较早内容再继续时。",
      "param_semantics": {
        "mode": "algorithmic 或 semantic；缺省 algorithmic（零 token）。",
        "goal": "本段要达成的目标。",
        "decisions": "已定决策列表。",
        "facts": "已确认事实列表。",
        "open_questions": "未决问题列表。",
        "files": "涉及的文件列表。",
        "next_steps": "后续步骤列表。",
        "covered_upto": "已压缩到的最后一条消息 id。"
      },
      "boundaries": "只写短期记忆 L1，不改写展示历史；不检索、不固化 L3。",
      "argsSchema": {
        "type": "object",
        "properties": {
          "mode": { "enum": ["algorithmic", "semantic"] },
          "goal": { "type": "string" },
          "decisions": { "type": "array", "items": { "type": "string" } },
          "facts": { "type": "array", "items": { "type": "string" } },
          "open_questions": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } },
          "next_steps": { "type": "array", "items": { "type": "string" } },
          "covered_upto": { "type": "string" }
        },
        "additionalProperties": true
      },
      "caps": { "fs": { "read": "none", "write": "none" }, "net": "none" },
      "idempotent": false,
      "hidden_params": ["conversation"],
      "render": { "form": "card", "label": "memory", "summary": "compress", "tone": "plain", "detail": { "kind": "json" } }
    },
    "memory.put": {
      "class": "memory",
      "method": "put",
      "intent": "把一条值得长期保留的事实写入长期记忆 L3。",
      "when_to_use": "确定了跨会话仍有用的事实、偏好或结论时。",
      "param_semantics": {
        "text": "要保存的条目文本。",
        "weight": "条目权重（0–1，可选）。",
        "meta": "条目元信息：source / workspace / session / at / tags。",
        "id": "条目 id（可选；缺省由 at + 文本派生）。"
      },
      "boundaries": "只写长期记忆 L3；不删改已有条目，不触发检索。",
      "argsSchema": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "meta": { "type": "object" },
          "id": { "type": "string" }
        },
        "additionalProperties": true
      },
      "caps": { "fs": { "read": "none", "write": "none" }, "net": "none" },
      "idempotent": false,
      "render": { "form": "card", "label": "memory", "summary": "put  {text}", "tone": "plain", "detail": { "kind": "json" } }
    },
    "memory.read": {
      "class": "memory",
      "method": "read",
      "intent": "按 id 取回长期记忆条目正文。",
      "when_to_use": "需要展开某条已召回记忆的完整内容时。",
      "param_semantics": {
        "hash": "条目 id（单个）。",
        "hashes": "条目 id 列表（批量）。"
      },
      "boundaries": "只读 L3，不写、不检索。",
      "argsSchema": {
        "type": "object",
        "properties": {
          "hash": { "type": "string" },
          "hashes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      },
      "caps": { "fs": { "read": "none", "write": "none" }, "net": "none" },
      "idempotent": true
    },
    "memory.candidates": {
      "class": "memory-maintenance",
      "method": "candidates",
      "intent": "列出可清理的过期 / 低价值记忆候选（不删除）。",
      "when_to_use": "需要查看哪些记忆可以遗忘、交由用户确认时。",
      "param_semantics": {
        "candidate_threshold": "低权重阈值（0–1，可选）。"
      },
      "boundaries": "只读，不删、不写。",
      "argsSchema": {
        "type": "object",
        "properties": { "candidate_threshold": { "type": "number", "minimum": 0, "maximum": 1 } },
        "additionalProperties": true
      },
      "caps": { "fs": { "read": "none", "write": "none" }, "net": "none" },
      "idempotent": true,
      "render": { "form": "card", "label": "memory", "summary": "candidates", "tone": "plain", "detail": { "kind": "json" } }
    },
    "retrieval.search": {
      "class": "retrieval",
      "method": "search",
      "intent": "按语义检索长期记忆，取回与当前问题相关的条目。",
      "when_to_use": "需要回忆过去会话中确认过的事实、偏好或结论时。",
      "param_semantics": {
        "query": "检索词 / 问题文本。",
        "goal": "本段要达成的目标（可选，拼进查询）。"
      },
      "boundaries": "只读检索，不写记忆；写入用保存记忆的工具。",
      "argsSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "goal": { "type": "string" },
          "workspace": { "type": "string" },
          "recall_budget": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      },
      "caps": { "fs": { "read": "none", "write": "none" }, "net": "none" },
      "idempotent": true,
      "hidden_params": ["workspace", "recall_budget"],
      "render": { "form": "card", "label": "memory", "summary": "recall  {query}", "tone": "plain", "detail": { "kind": "json" } }
    }
  }
}
