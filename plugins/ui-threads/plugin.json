{
  "identity": "ui-threads",
  "implements": ["ui-threads"],
  "methods": {
    "ui-threads": ["ping", "threads.state"]
  },
  "pins": {},
  "start": "node execute/main.ts",
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "probe": "ui-threads.ping",
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "recomputable",
  "members": [
    { "kind": "execute", "path": "execute/" },
    { "kind": "term", "path": "terms/" }
  ],
  "commands": [
    { "name": "threads.state", "entry": "terms/threads.state.json" }
  ]
}
