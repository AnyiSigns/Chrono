{
  "identity": "workspace",
  "schema": "schema/workspace.json",
  "implements": ["workspace"],
  "methods": {
    "workspace": ["list", "read", "pick", "add", "remove", "reveal"]
  },
  "pins": {},
  "start": "node execute/launch.mjs",
  "build": [{ "cmd": "cargo", "args": ["build", "--release"] }],
  "exclusive": ["data"],
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "probe": "workspace.list",
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "durable",
  "members": [
    { "kind": "execute", "path": "execute/" },
    { "kind": "schema", "path": "schema/" }
  ],
  "commands": []
}
