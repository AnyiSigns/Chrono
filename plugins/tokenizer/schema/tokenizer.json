{
  "title": "tokenizer（真实分词与窗口切块）",
  "description": "身份自述 / 数据契约：描述 tokenizer 能力类两方法 encode / chunk 的入参与结果形状，并登记构建期分词器资产。分词器文件不进世界，宿主物化时按顶层 assets_manifest 从投递包源目录直拷到物化目录（供 include_bytes! 构建期读取）。服务不读投影、无写通道：一切输入随 bag 由调用方入口 term 或提供方反向 port.call 传入。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "encode_request": {
      "type": "object",
      "description": "encode 的 bag：text 为待编码文本；add_special_tokens 缺省 true（加 CLS / EOS）。",
      "required": ["text"],
      "additionalProperties": true,
      "properties": {
        "text": { "type": "string" },
        "add_special_tokens": { "type": "boolean" }
      }
    },
    "encode_result": {
      "type": "object",
      "description": "encode 结果：ids / mask / offsets 逐 token 一一对应；offsets 为 [start, end] 字节偏移（tokenizers 原生口径）。",
      "required": ["ids", "mask", "offsets"],
      "additionalProperties": false,
      "properties": {
        "ids": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "mask": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "offsets": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "chunk_request": {
      "type": "object",
      "description": "chunk 的 bag：window / overlap 按 token 计（缺省 512 / 64）；输出的 start / end 一律是 Unicode 码点偏移。",
      "required": ["text"],
      "additionalProperties": true,
      "properties": {
        "text": { "type": "string" },
        "window": { "type": "integer", "minimum": 1 },
        "overlap": { "type": "integer", "minimum": 0 }
      }
    },
    "chunk_result": {
      "type": "array",
      "description": "chunk 结果：逐块 {index, start, end, text}；start / end 为码点偏移，text = 原文本的码点切片。",
      "items": {
        "type": "object",
        "required": ["index", "start", "end", "text"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "text": { "type": "string" }
        }
      }
    }
  },
  "assets_manifest": [
    {
      "path": "granite-97m/tokenizer.json",
      "sha256": "4f2842d568e2724370aec203652a42ac783c7937f8347a1a2cc7506d71f1582f",
      "size": 25301672
    }
  ]
}
