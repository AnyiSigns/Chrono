{
  "identity": "ui-sidebar",
  "implements": ["ui-sidebar"],
  "methods": {
    "ui-sidebar": [
      "ping",
      "clientRead",
      "newConversation",
      "selectConversation",
      "renameConversation",
      "deleteConversation",
      "restoreConversation",
      "branchConversation",
      "listWorkspaces",
      "pickWorkspace",
      "addWorkspace",
      "removeWorkspace",
      "revealWorkspace"
    ]
  },
  "pins": {
    "session": "session",
    "workspace": "workspace"
  },
  "start": "node execute/main.js",
  "build": [
    { "cmd": "npm", "args": ["ci"] },
    { "cmd": "node", "args": ["execute/build.mjs"] }
  ],
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "probe": "ui-sidebar.ping",
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "recomputable",
  "members": [
    { "kind": "execute", "path": "execute/" },
    { "kind": "term", "path": "terms/" }
  ],
  "commands": [
    { "name": "session.new", "entry": "terms/session.new.json" },
    { "name": "session.select", "entry": "terms/session.select.json" },
    { "name": "session.rename", "entry": "terms/session.rename.json" },
    { "name": "session.delete", "entry": "terms/session.delete.json" },
    { "name": "session.restore", "entry": "terms/session.restore.json" },
    { "name": "session.branch", "entry": "terms/session.branch.json" },
    { "name": "workspace.list", "entry": "terms/workspace.list.json", "readonly": true },
    { "name": "workspace.pick", "entry": "terms/workspace.pick.json" },
    { "name": "workspace.add", "entry": "terms/workspace.add.json" },
    { "name": "workspace.remove", "entry": "terms/workspace.remove.json" },
    { "name": "workspace.reveal", "entry": "terms/workspace.reveal.json" },
    { "name": "ui-sidebar.client.read", "entry": "terms/client.read.json", "readonly": true }
  ]
}
