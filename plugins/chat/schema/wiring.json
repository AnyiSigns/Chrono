{
  "slices": {
    "prompt": true,
    "l2": true,
    "l1": true,
    "skill": true,
    "recall": false,
    "history": true,
    "style": true
  },
  "system_prompt": "你是 Chrono 的对话助手。只谈意图与结果，不输出工具名、插件名或能力类名。回答简洁、准确，按用户语言作答。",
  "tools": [],
  "title": {
    "segment": "session-title.generate",
    "when": "first_message",
    "on_fail": "ignore",
    "title_default": "新对话",
    "args": ["conversation", "first_message", "vendor", "model", "params", "config", "session", "title_default"]
  },
  "on_empty_slot": "noop",
  "on_budget": "fail",
  "stream": { "topic": "model.delta" },
  "method_timeouts": {
    "chat.send": 600000,
    "chat.resume": 600000
  }
}
