{
  "identity": "ui-settings",
  "implements": [
    "ui-settings"
  ],
  "methods": {
    "ui-settings": [
      "ping",
      "vendors",
      "profile",
      "discover",
      "health",
      "view",
      "search",
      "edit"
    ]
  },
  "pins": {
    "model": "model-protocol",
    "secrets": "secrets",
    "retrieval": "memory-retrieval",
    "memory-maintenance": "memory-consolidate"
  },
  "start": "node execute/main.ts",
  "exclusive": ["port"],
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "probe": "ui-settings.ping",
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "recomputable",
  "members": [
    {
      "kind": "execute",
      "path": "execute/"
    },
    {
      "kind": "term",
      "path": "terms/"
    }
  ],
  "commands": [
    {
      "name": "model.vendors",
      "entry": "terms/model.vendors.json",
      "readonly": true
    },
    {
      "name": "model.discover",
      "entry": "terms/model.discover.json"
    },
    {
      "name": "model.profile",
      "entry": "terms/model.profile.json"
    },
    {
      "name": "secrets.status",
      "entry": "terms/secrets.status.json",
      "readonly": true
    },
    {
      "name": "settings.identities",
      "entry": "terms/settings.identities.json",
      "readonly": true
    },
    {
      "name": "settings.skills",
      "entry": "terms/settings.skills.json",
      "readonly": true
    },
    {
      "name": "orchestration.graph",
      "entry": "terms/orchestration.graph.json",
      "readonly": true
    },
    {
      "name": "orchestration.scopes",
      "entry": "terms/orchestration.scopes.json",
      "readonly": true
    },
    {
      "name": "orchestration.health",
      "entry": "terms/orchestration.health.json",
      "readonly": true
    },
    {
      "name": "memory.view",
      "entry": "terms/memory.view.json",
      "readonly": true
    },
    {
      "name": "memory.search",
      "entry": "terms/memory.search.json"
    },
    {
      "name": "memory.edit",
      "entry": "terms/memory.edit.json"
    }
  ]
}
