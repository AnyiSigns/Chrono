{
  "identity": "ui-settings",
  "implements": ["ui-settings", "ui-nav", "ui-slot"],
  "methods": {
    "ui-settings": [
      "ping",
      "vendors",
      "profile",
      "discover",
      "health",
      "graph",
      "scopes",
      "client.read",
      "secret"
    ],
    "ui-slot": ["list"]
  },
  "concurrent_methods": ["vendors", "health", "graph", "scopes", "client.read"],
  "needs": {
    "host": { "mode": "one" },
    "model": { "mode": "one" },
    "secrets": { "mode": "one" },
    "ref-hydrate": { "mode": "one" },
    "input": { "mode": "one" },
    "skill": { "mode": "one" },
    "config": { "mode": "one" }
  },
  "start": "node execute/main.ts",
  "build": [
    { "cmd": "npm", "args": ["ci"] },
    { "cmd": "node", "args": ["../../plugin-sdk/tools/build-ui.mjs"] }
  ],
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "recomputable",
  "members": [
    {
      "kind": "execute",
      "path": "execute/"
    },
    {
      "kind": "term",
      "path": "terms/"
    }
  ],
  "commands": [
    {
      "name": "model.vendors",
      "entry": "terms/model.vendors.json",
      "readonly": true
    },
    {
      "name": "model.discover",
      "entry": "terms/model.discover.json"
    },
    {
      "name": "model.profile",
      "entry": "terms/model.profile.json"
    },
    {
      "name": "secrets.status",
      "entry": "terms/secrets.status.json",
      "readonly": true
    },
    {
      "name": "settings.identities",
      "entry": "terms/settings.identities.json",
      "readonly": true
    },
    {
      "name": "settings.skills",
      "entry": "terms/settings.skills.json",
      "readonly": true
    },
    {
      "name": "orchestration.graph",
      "entry": "terms/orchestration.graph.json",
      "readonly": true
    },
    {
      "name": "orchestration.scopes",
      "entry": "terms/orchestration.scopes.json",
      "readonly": true
    },
    {
      "name": "orchestration.health",
      "entry": "terms/orchestration.health.json",
      "readonly": true
    },
    {
      "name": "ui-settings.client.read",
      "entry": "terms/client.read.json",
      "readonly": true
    },
    {
      "name": "ui-settings.secret",
      "entry": "terms/secret.json",
      "readonly": true
    }
  ]
}
