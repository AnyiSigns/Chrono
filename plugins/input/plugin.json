{
  "identity": "input",
  "schema": "schema/slot.schema.json",
  "implements": ["input"],
  "methods": {
    "input": ["read", "write", "clear"]
  },
  "pins": {},
  "start": "node execute/main.ts",
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "durable",
  "exclusive": ["data"],
  "members": [
    { "kind": "execute", "path": "execute/" },
    { "kind": "term", "path": "terms/" },
    { "kind": "schema", "path": "schema/" }
  ],
  "commands": [
    {
      "name": "input.read",
      "entry": "terms/input.read.json",
      "argsSchema": "schema/input.read.args.json",
      "readonly": true
    },
    {
      "name": "input.write",
      "entry": "terms/input.write.json",
      "argsSchema": "schema/input.write.args.json"
    }
  ]
}
