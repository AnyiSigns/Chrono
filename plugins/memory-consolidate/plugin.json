{
  "identity": "memory-consolidate",
  "schema": "schema/memory-maintenance.json",
  "implements": ["memory-maintenance"],
  "methods": {
    "memory-maintenance": ["consolidate", "sweep", "candidates", "view", "edit"]
  },
  "pins": {
    "compress": "compress",
    "embedding": "embedding",
    "memory": "memory-store",
    "short-memory": "short-memory",
    "session": "session"
  },
  "start": "node execute/main.ts",
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "probe": "memory-maintenance.view",
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "recomputable",
  "members": [
    { "kind": "execute", "path": "execute/" },
    { "kind": "schema", "path": "schema/" }
  ],
  "commands": []
}
