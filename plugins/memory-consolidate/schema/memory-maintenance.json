{
  "title": "memory-consolidate（记忆维护 · 全层）",
  "description": "身份自述 / 数据契约：能力类 memory-maintenance 的五个方法（consolidate / sweep / candidates / view / edit）的 bag 与结果形状，以及本插件自用的策略参数。L1/L2（short-memory）与 L3（memory-store）都是运行记录、已出世界：本服务经反向调用读写 owner 服务，不读投影、不产世界写计划。会话 → 工作区归属经反向调用 session.read。sweep 水位住宿主侧 ③（可重算）。时间由调用帧 env 传入（不自取时钟），同输入同输出。",
  "type": "object",
  "additionalProperties": true,
  "params": {
    "l1_ttl_ms": 86400000,
    "l2_capacity": 200,
    "l3_capacity": 500,
    "dedup_cosine_threshold": 0.9,
    "consolidate_weight_threshold": 0.7,
    "candidate_weight_threshold": 0.2,
    "solidify_full_sources": 4
  },
  "properties": {
    "consolidate_bag": {
      "type": "object",
      "additionalProperties": true,
      "description": "consolidate 的 bag。owner 数据由服务自行读取，调用方只需给可选策略覆盖。",
      "properties": {
        "workspace": { "type": "string", "description": "可选：显式目标工作区（session 无归属时的回落）。" },
        "summarize": { "type": "boolean", "description": "需要摘要时置 true：eff compress.summarize（persist:false）产合并摘要（失败即明确失败、不半写）。" },
        "high_value": { "type": "array", "items": { "type": "string" }, "description": "可选：强制固化的条目文本（绕过权重阈值）。" },
        "item_weights": { "type": "object", "additionalProperties": true, "description": "可选：条目文本 → 固化权重（0–1）。" },
        "embedding_model": { "type": "string" },
        "dedup_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "weight_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "l2_capacity": { "type": "integer", "minimum": 1 },
        "now": {}
      }
    },
    "sweep_bag": {
      "type": "object",
      "additionalProperties": true,
      "description": "sweep 的 bag。cursor = 上次 sweep 水位（args 显式给出时确定性；缺省读宿主 ③ 水位文件）。",
      "properties": {
        "cursor": { "type": "string", "description": "增量游标（ISO at）：只扫描水位之后新增 / 变更的条目。" },
        "l1_ttl_ms": { "type": "integer", "minimum": 1 },
        "l2_capacity": { "type": "integer", "minimum": 1 },
        "l3_capacity": { "type": "integer", "minimum": 1 },
        "candidate_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "now": {}
      }
    },
    "candidates_bag": {
      "type": "object",
      "additionalProperties": true,
      "description": "candidates 的 bag：只读回候选列表（L1 过期 / L2 超容量 / L3 低权重），不删、不写。",
      "properties": {
        "candidate_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "now": {}
      }
    },
    "view_bag": {
      "type": "object",
      "additionalProperties": true,
      "description": "view 的 bag：只读回 L1 / L2 / L3 三档；L3 字段与条目一致（at / tags / source / weight / pinned），L1 另含剩余 TTL。",
      "properties": {
        "now": {}
      }
    },
    "edit_bag": {
      "type": "object",
      "additionalProperties": true,
      "description": "edit 的 bag：删除 / 置顶 / 文本编辑经反向调用写 owner 服务。",
      "required": ["action", "layer", "id"],
      "properties": {
        "action": { "enum": ["delete", "pin", "text"] },
        "layer": { "enum": ["l1", "l2", "l3"] },
        "id": { "type": "string" },
        "patch": { "type": "object", "additionalProperties": true, "description": "pin: {pinned:false} 取消置顶；text: {text} 或 {summary}。" },
        "slot": { "type": "object", "additionalProperties": true, "description": "可选：槽体（字段同 action / layer / id / patch）。" },
        "now": {}
      }
    },
    "consolidate_result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "consolidate" },
        "merged": { "type": "array", "items": { "type": "object" } },
        "solidified": { "type": "array", "items": { "type": "object" } },
        "dedup": { "enum": ["vector"] }
      }
    },
    "sweep_result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "sweep" },
        "l1_deleted": { "type": "array", "items": { "type": "string" } },
        "l2_trimmed": { "type": "array", "items": { "type": "object" } },
        "l3_deleted": { "type": "array", "items": { "type": "object" } },
        "cursor_next": { "type": "string" }
      }
    },
    "candidates_result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "candidates" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "layer": { "enum": ["l1", "l2", "l3"] },
              "id": { "type": "string" },
              "reason": { "enum": ["l1_expired", "l2_over_capacity", "low_weight"] }
            }
          }
        }
      }
    },
    "view_result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "view" },
        "l1": { "type": "array", "items": { "type": "object" } },
        "l2": { "type": "array", "items": { "type": "object" } },
        "l3": { "type": "array", "items": { "type": "object" } }
      }
    },
    "edit_result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "edit" },
        "action": { "enum": ["delete", "pin", "text"] },
        "layer": { "enum": ["l1", "l2", "l3"] },
        "id": { "type": "string" }
      }
    }
  },
  "periodic": [
    { "method": "consolidate", "every_ms": 3600000 },
    { "method": "sweep", "every_ms": 1800000 }
  ],
  "method_timeouts": {
    "memory-maintenance.consolidate": 120000,
    "memory-maintenance.sweep": 120000
  }
}
