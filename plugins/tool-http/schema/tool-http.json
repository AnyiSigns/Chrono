{
  "title": "tool-http（联网检索与抓取）",
  "description": "身份自述 / 数据契约：描述 websearch 与 webfetch 的入参、结果形状，以及可热改的运行配置。配置默认值住本文件的 defaults；运行时优先用本身份数据世代 body（调用方随 bag 传入），缺省回落本文件。schema 出生即冻结，改配置走数据换代。",
  "type": "object",
  "additionalProperties": true,
  "method_timeouts": {
    "tool-http.invoke": 130000
  },
  "properties": {
    "websearch_request": {
      "type": "object",
      "description": "websearch 的 args：query 必填；count / sources 可选。",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "description": "检索词。" },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "结果条数上限；缺省取配置 top_n。"
        },
        "sources": {
          "type": "array",
          "description": "只查这些源（按源 id 或名字匹配）；缺省查全部启用源。",
          "items": { "type": "string" }
        },
        "highlights": {
          "type": "boolean",
          "description": "只要与查询最相关的段落而非整页正文；给 true 时按缺省条数抓取。"
        }
      }
    },
    "websearch_result": {
      "type": "object",
      "description": "websearch 的结果：合并排序后的条目与源使用情况。",
      "required": ["results", "sources_used", "sources_failed"],
      "additionalProperties": true,
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url", "snippet", "source", "rank"],
            "additionalProperties": true,
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "description": "规范化后的 URL。" },
              "snippet": { "type": "string" },
              "source": { "type": "string", "description": "贡献该条目的源名。" },
              "rank": { "type": "integer", "minimum": 1, "description": "合并后的名次。" }
            }
          }
        },
        "sources_used": { "type": "array", "items": { "type": "string" } },
        "sources_failed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "code"],
            "additionalProperties": true,
            "properties": {
              "source": { "type": "string" },
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "webfetch_request": {
      "type": "object",
      "description": "webfetch 的 args：url 必填；format 可选。",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "description": "http(s) URL。" },
        "format": {
          "enum": ["markdown", "text", "raw"],
          "description": "HTML 输出形态；缺省 markdown。"
        }
      }
    },
    "webfetch_result": {
      "type": "object",
      "description": "webfetch 的结果：正文 / 原样内容，或二进制资产引用。",
      "required": ["url", "status", "content_type", "content", "truncated"],
      "additionalProperties": true,
      "properties": {
        "url": { "type": "string", "description": "最终 URL（跟随重定向后）。" },
        "status": { "type": "integer", "description": "HTTP 状态码。" },
        "content_type": { "type": "string" },
        "content": { "type": "string", "description": "文本内容；二进制时为空串。" },
        "truncated": { "type": "boolean" },
        "asset": {
          "type": "object",
          "description": "二进制响应体存资产后的引用。",
          "additionalProperties": true,
          "properties": {
            "kind": { "const": "asset" },
            "sha256": { "type": "string" },
            "mime": { "type": "string" },
            "size": { "type": "integer" }
          }
        }
      }
    },
    "webresearch_request": {
      "type": "object",
      "description": "webresearch 的 args：query 必填；count / sources / read / max_chars 可选。",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "description": "检索词。" },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "候选条数上限；缺省取配置 top_n。"
        },
        "sources": {
          "type": "array",
          "description": "只查这些源（按源 id 或名字匹配）；缺省查全部启用源。",
          "items": { "type": "string" }
        },
        "read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "抓取正文的条数；缺省 3，0 = 只检索不读正文。"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 200,
          "maximum": 20000,
          "description": "每页正文抽取的字符上限；缺省 4000。"
        },
        "highlights": {
          "type": "boolean",
          "description": "只要与查询最相关的段落而非整页正文；给 true 时按缺省条数抓取。"
        }
      }
    },
    "webresearch_result": {
      "type": "object",
      "description": "webresearch 的结果：检索候选（前若干条带抽取正文）+ 源使用 / 读正文的成败。",
      "required": ["results", "sources_used", "sources_failed", "read_used", "read_failed"],
      "additionalProperties": true,
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url", "source", "rank"],
            "additionalProperties": true,
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "description": "规范化后的 URL。" },
              "snippet": { "type": "string" },
              "source": { "type": "string", "description": "贡献该条目的源名。" },
              "rank": { "type": "integer", "minimum": 1 },
              "read": { "type": "boolean", "description": "是否已抽取正文。" },
              "status": { "type": ["integer", "null"], "description": "读正文时的 HTTP 状态码。" },
              "content_type": { "type": "string" },
              "content": { "type": "string", "description": "抽取的成段正文（markdown）。" },
              "truncated": { "type": "boolean", "description": "正文是否按 max_chars 截断。" },
              "error": {
                "type": "object",
                "description": "读正文失败时的结构化错误。",
                "properties": { "code": { "type": "string" } }
              }
            }
          }
        },
        "sources_used": { "type": "array", "items": { "type": "string" } },
        "sources_failed": { "type": "array", "items": { "type": "object" } },
        "read_used": { "type": "array", "items": { "type": "string" } },
        "read_failed": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "defaults": {
    "version": 1,
    "rrf_k": 60,
    "top_n": 10,
    "output_max": 1048576,
    "user_agent": "chrono-tool-http/1.0",
    "obey_robots": false,
    "redirect_max": 5,
    "block_private_hosts": true,
    "fetcher_cmd": "",
    "fetcher_env": {},
    "source_timeout_ms": 8000,
    "index_enabled": true,
    "index_name": "Index",
    "render_min_chars": 200,
    "sources": [
      {
        "id": "bing-rss",
        "name": "Bing RSS",
        "kind": "bing-rss",
        "parse": "bing-rss",
        "enabled": true,
        "endpoint": "https://www.bing.com/search",
        "query_param": "q",
        "extra_query": { "format": "rss" },
        "timeout_ms": 8000
      },
      {
        "id": "mojeek",
        "name": "Mojeek",
        "kind": "html",
        "parse": "mojeek",
        "enabled": true,
        "endpoint": "https://www.mojeek.com/search",
        "query_param": "q",
        "timeout_ms": 8000
      },
      {
        "id": "openalex",
        "name": "OpenAlex",
        "kind": "openalex",
        "parse": "openalex",
        "enabled": true,
        "endpoint": "https://api.openalex.org/works",
        "query_param": "search",
        "extra_query": { "per_page": "10" },
        "timeout_ms": 8000
      },
      {
        "id": "stackexchange",
        "name": "Stack Exchange",
        "kind": "stackexchange",
        "parse": "stackexchange",
        "enabled": true,
        "endpoint": "https://api.stackexchange.com/2.3/search/advanced",
        "query_param": "q",
        "extra_query": {
          "order": "desc",
          "sort": "relevance",
          "site": "stackoverflow",
          "filter": "default"
        },
        "timeout_ms": 8000
      },
      {
        "id": "hn",
        "name": "Hacker News",
        "kind": "hn-algolia",
        "parse": "hn-algolia",
        "enabled": true,
        "endpoint": "https://hn.algolia.com/api/v1/search",
        "query_param": "query",
        "extra_query": { "tags": "story", "hitsPerPage": "10" },
        "timeout_ms": 8000
      },
      {
        "id": "arxiv",
        "name": "arXiv",
        "kind": "arxiv",
        "parse": "arxiv",
        "enabled": true,
        "endpoint": "https://export.arxiv.org/api/query",
        "query_param": "search_query",
        "query_prefix": "all:",
        "extra_query": { "max_results": "10", "sortBy": "relevance" },
        "timeout_ms": 8000
      },
      {
        "id": "github",
        "name": "GitHub",
        "kind": "github",
        "parse": "github",
        "enabled": false,
        "endpoint": "https://api.github.com/search/repositories",
        "query_param": "q",
        "extra_query": { "per_page": "10" },
        "headers": { "Accept": "application/vnd.github+json" },
        "timeout_ms": 8000
      },
      {
        "id": "marginalia",
        "name": "Marginalia",
        "kind": "marginalia",
        "parse": "marginalia",
        "enabled": false,
        "endpoint": "https://api2.marginalia-search.com/search",
        "query_param": "query",
        "extra_query": { "count": "10" },
        "headers": { "API-Key": "public" },
        "timeout_ms": 8000
      },
      {
        "id": "wikipedia",
        "name": "Wikipedia",
        "kind": "wikipedia",
        "parse": "wikipedia-json",
        "enabled": false,
        "endpoint": "https://en.wikipedia.org/w/api.php",
        "query_param": "srsearch",
        "language": "en",
        "timeout_ms": 8000
      },
      {
        "id": "searxng",
        "name": "SearXNG",
        "kind": "searxng",
        "parse": "searxng",
        "enabled": false,
        "endpoint": null,
        "instances": ["https://searx.be", "https://search.inetol.net"],
        "query_param": "q",
        "timeout_ms": 8000
      }
    ]
  }
}
