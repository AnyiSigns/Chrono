{
  "identity": "evolve-ledger",
  "schema": "schema/evolve-ledger.json",
  "implements": ["evolve-ledger", "evolve-metrics"],
  "methods": {
    "evolve-ledger": ["read-chain", "patch-plan", "thresholds", "hash"],
    "evolve-metrics": ["aggregate", "sweep", "shadow", "record"]
  },
  "needs": {
    "host": { "mode": "one" }
  },
  "start": "node execute/launch.mjs",
  "build": [{ "cmd": "cargo", "args": ["build", "--release"] }],
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "recomputable",
  "members": [
    { "kind": "execute", "path": "execute/" },
    { "kind": "execute", "path": "src/" },
    { "kind": "schema", "path": "schema/" }
  ],
  "commands": []
}
