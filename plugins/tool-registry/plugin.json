{
  "identity": "tool-registry",
  "schema": "schema/tool-registry.json",
  "implements": ["tool-registry"],
  "methods": {
    "tool-registry": ["list", "validate-args"]
  },
  "slots": {
    "tool-provider": { "methods": ["describe", "invoke"] }
  },
  "needs": {
    "tool-provider": { "mode": "many" },
    "session": { "mode": "one" },
    "evolve-metrics": { "mode": "one" }
  },
  "start": "node execute/main.ts",
  "build": [],
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "recomputable",
  "members": [
    { "kind": "execute", "path": "execute/" },
    { "kind": "schema", "path": "schema/" }
  ],
  "commands": []
}
