{
  "identity": "model-protocol",
  "schema": "schema/protocol.json",
  "implements": ["model"],
  "methods": {
    "model": ["chat", "complete", "vendors", "discover", "profile", "sync"]
  },
  "pins": { "secrets": "secrets", "config": "config" },
  "start": "node execute/main.ts",
  "protocol": "1",
  "restart": {
    "policy": "on-exit",
    "backoff": "exponential",
    "backoff_ms": 500,
    "backoff_max_ms": 30000,
    "max": 5,
    "window_ms": 60000,
    "drain_ms": 5000
  },
  "health": {
    "probe": "model.chat",
    "interval_ms": 10000,
    "timeout_ms": 2000
  },
  "state": "recomputable",
  "members": [
    { "kind": "execute", "path": "execute/" },
    { "kind": "schema", "path": "schema/" }
  ],
  "commands": []
}
