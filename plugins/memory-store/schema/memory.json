{
  "title": "memory-store（长期记忆本体）",
  "description": "身份自述 / 数据契约：L3 长期记忆条目各自成 def、经链式 tail 串联（body 只存链尾与计数，不列全部条目哈希）；条目含 chunks 偏移（只存偏移不重复存文本）。向量本体不进世界，索引住宿主侧 ③（state/plugins/memory-store/index-<model>-<dim>.bin，可重算）。写一律经写计划落账：put 回去重后的写计划（条目 def + 新 body + add_gen），read / search 只读不回计划。服务不读投影：body + refs 由调用方入口 term 读出随 args 传入。deleted / pinned 过滤写死为契约，读取方（含本插件 read / search）必须遵守。",
  "type": "object",
  "additionalProperties": true,
  "model": {
    "id": "granite-97m",
    "dim": 384
  },
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": true,
      "description": "memory-store 身份 body：链尾 + 计数 + 逻辑删除 / 置顶集合 + 索引版本锚。",
      "properties": {
        "tail": { "type": "object", "additionalProperties": true, "description": "{def: <最新条目 def 哈希>} 或 null。" },
        "count": { "type": "integer", "minimum": 0, "description": "累计写入条目数（删除不递减）。" },
        "deleted": { "type": "object", "additionalProperties": true, "description": "{<条目 id>: <删除时间 at>}；读取方必须据此过滤。" },
        "pinned": { "type": "object", "additionalProperties": true, "description": "{<条目 id>: true}；淘汰时跳过。" },
        "model": {
          "type": "object",
          "additionalProperties": true,
          "description": "索引版本锚 {id, dim}；仅记录，向量在 ③。",
          "properties": {
            "id": { "type": "string" },
            "dim": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": true,
      "description": "条目 def：各自成 def、内容寻址；chunks 只存偏移，文本由 text 切片派生。",
      "properties": {
        "id": { "type": "string", "description": "条目逻辑 id（m-…），deleted / pinned 以此为键。" },
        "text": { "type": "string" },
        "meta": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "source": { "enum": ["session", "skill", "manual", "consolidate"] },
            "workspace": { "type": "string" },
            "session": { "type": "string" },
            "at": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        "weight": { "type": "number", "minimum": 0, "maximum": 1, "description": "可选：容量淘汰权重。" },
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "prev": { "type": "object", "additionalProperties": true, "description": "{def: <上一条目哈希>} 或 null。" }
      }
    },
    "put_request": {
      "type": "object",
      "required": ["text", "body", "refs"],
      "additionalProperties": true,
      "description": "put 入参：agent 显式保存经记忆工具派发。body + refs 由调用方入口 term 读出传入。",
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "meta": { "type": "object", "additionalProperties": true },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "id": { "type": "string" },
        "dedup_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "body": { "type": "object", "additionalProperties": true },
        "refs": { "type": "object", "additionalProperties": true }
      }
    },
    "put_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "成功时 {$directives:[batch(write put(条目 def)+put(新 body)+add_gen), extern({ok:true,kind:'put',saved:…})]}；重复回只含 extern 的计划（saved:false, duplicate_of）；失败回 {ok:false, error:{code,message}}。",
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "put" },
        "saved": { "type": "boolean" },
        "duplicate": { "type": "boolean" },
        "dedup": { "enum": ["vector", "none"] }
      }
    },
    "read_request": {
      "type": "object",
      "required": ["body", "refs"],
      "additionalProperties": true,
      "description": "read 入参：按 hash 或 hashes 从传入的 refs 取条目；deleted 条目按契约过滤为 null。消费方 = 检索插件（按 search 的 entry_hash 取正文）。",
      "properties": {
        "body": { "type": "object", "additionalProperties": true },
        "refs": { "type": "object", "additionalProperties": true },
        "hash": { "type": "string" },
        "hashes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "read_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "hash 形式回 {ok:true,kind:'read',hash,entry}；hashes 形式回 {ok:true,kind:'read',entries:[{hash,entry}],missing:[…]}；entry 为 null 表示缺失或已删除。",
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "read" }
      }
    },
    "search_request": {
      "type": "object",
      "required": ["query_vector", "body", "refs"],
      "additionalProperties": true,
      "description": "search 入参：在 ③ 索引上暴力余弦（dim 384 归一 ⇒ 点积）。query_vector 由调用方经向量化服务算出；body + refs 供索引重建与 deleted 过滤。",
      "properties": {
        "query_vector": { "type": "array", "items": { "type": "number" } },
        "top_k": { "type": "integer", "minimum": 1 },
        "rebuild": { "type": "boolean" },
        "body": { "type": "object", "additionalProperties": true },
        "refs": { "type": "object", "additionalProperties": true }
      }
    },
    "search_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "索引就绪回 {ok:true,kind:'search',status:'ready',model,hits:[{entry_hash,chunk_index,score}]}（chunk 级命中，按 score 降序、同分按 entry_hash/chunk_index 定序）；重建中回 {ok:true,kind:'search',status:'index_building',hits:[]}；形态 / 维度不符回 {ok:false,error:{code,message}}。",
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "search" },
        "status": { "enum": ["ready", "index_building"] },
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "entry_hash": { "type": "string" },
              "chunk_index": { "type": "integer", "minimum": 0 },
              "score": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "method_timeouts": {
    "memory.put": 600000,
    "memory.search": 600000
  }
}
