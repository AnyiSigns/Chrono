{
  "title": "memory-store（长期记忆本体）",
  "description": "身份自述 / 数据契约。L3 长期记忆条目与 body 是运行记录，已出世界：住本服务自有持久存储（④ CHRONO_PLUGIN_DATA/memory.jsonl，追加日志）。条目经链式 tail → prev（按条目 id 串联）；chunks 只存偏移，文本由 text 切片派生。向量本体不进 ④，索引住 ③ CHRONO_PLUGIN_STATE/index-<model>-<dim>.bin，可由 ④ 重算、删掉可重建。写（put / append / delete / pin / edit）即时落自有存储，不产世界写计划；read / search / list 只读。deleted / pinned 过滤写死为契约，读取方（含本插件 read / search / list）必须遵守。服务不读投影。",
  "type": "object",
  "additionalProperties": true,
  "model": {
    "id": "granite-97m",
    "dim": 384
  },
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": true,
      "description": "存储内 body（④ 重放得到）：链尾 + 计数 + 逻辑删除 / 置顶集合 + 索引版本锚。",
      "properties": {
        "tail": { "type": "object", "additionalProperties": true, "description": "{def: <最新条目 id>} 或 null。" },
        "count": { "type": "integer", "minimum": 0, "description": "累计写入条目数（删除不递减）。" },
        "deleted": { "type": "object", "additionalProperties": true, "description": "{<条目 id>: <删除时间 at>}；读取方必须据此过滤。" },
        "pinned": { "type": "object", "additionalProperties": true, "description": "{<条目 id>: true}；淘汰时跳过。" },
        "model": {
          "type": "object",
          "additionalProperties": true,
          "description": "索引版本锚 {id, dim}；仅记录，向量在 ③。",
          "properties": {
            "id": { "type": "string" },
            "dim": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": true,
      "description": "条目：id 为链键与 deleted / pinned 键；chunks 只存偏移，文本由 text 切片派生。",
      "properties": {
        "id": { "type": "string", "description": "条目逻辑 id（m-…）。" },
        "text": { "type": "string" },
        "meta": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "source": { "enum": ["session", "skill", "manual", "consolidate"] },
            "workspace": { "type": "string" },
            "session": { "type": "string" },
            "at": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        "weight": { "type": "number", "minimum": 0, "maximum": 1, "description": "可选：容量淘汰权重。" },
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "prev": { "type": "object", "additionalProperties": true, "description": "{def: <上一条目 id>} 或 null。" }
      }
    },
    "put_request": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": true,
      "description": "put 入参：agent 显式保存经记忆工具派发。去重后直接写自有存储。",
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "meta": { "type": "object", "additionalProperties": true },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "id": { "type": "string" },
        "dedup_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "put_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "成功回 {ok:true,kind:'put',saved:true,id,count,chunks,dedup:'vector',model}；重复回 {ok:true,saved:false,duplicate:true,duplicate_of}；失败回 {ok:false,error:{code,message}}。不产 $directives。",
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "put" },
        "saved": { "type": "boolean" },
        "duplicate": { "type": "boolean" },
        "dedup": { "enum": ["vector", "none"] }
      }
    },
    "read_request": {
      "type": "object",
      "additionalProperties": true,
      "description": "read 入参：按 id（hash / hashes）从自有存储取条目；deleted 条目按契约过滤为 null。消费方 = 检索插件（按 search 的 entry_hash 取正文）。",
      "properties": {
        "hash": { "type": "string" },
        "hashes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "read_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "hash 形式回 {ok:true,kind:'read',hash,entry}；hashes 形式回 {ok:true,kind:'read',entries:[{hash,entry}],missing:[…]}；entry 为 null 表示缺失或已删除。",
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "read" }
      }
    },
    "search_request": {
      "type": "object",
      "required": ["query_vector"],
      "additionalProperties": true,
      "description": "search 入参：在 ③ 索引上暴力余弦（dim 384 归一 ⇒ 点积）。query_vector 由调用方经向量化服务算出；索引缺失 / 落后即由 ④ 重建。",
      "properties": {
        "query_vector": { "type": "array", "items": { "type": "number" } },
        "top_k": { "type": "integer", "minimum": 1 },
        "rebuild": { "type": "boolean" }
      }
    },
    "search_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "索引就绪回 {ok:true,kind:'search',status:'ready',model,hits:[{entry_hash,chunk_index,score}]}；重建中回 {ok:true,kind:'search',status:'index_building',hits:[]}；形态 / 维度不符回 {ok:false,error:{code,message}}。",
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "search" },
        "status": { "enum": ["ready", "index_building"] },
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "entry_hash": { "type": "string" },
              "chunk_index": { "type": "integer", "minimum": 0 },
              "score": { "type": "number" }
            }
          }
        }
      }
    },
    "list_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "list 回 {ok:true,kind:'list',entries:[{id,text,meta,weight}],count}（存活条目，新→旧）；供记忆维护读取与去重。",
      "properties": {
        "ok": { "type": "boolean" },
        "kind": { "const": "list" }
      }
    },
    "append_request": {
      "type": "object",
      "required": ["entries"],
      "additionalProperties": true,
      "description": "append 入参：批量追加条目（记忆维护固化用）。每项 {id?,text,meta?,weight?}；服务算 chunks / 向量后写自有存储并增量入索引。",
      "properties": {
        "entries": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "delete_request": {
      "type": "object",
      "required": ["ids"],
      "additionalProperties": true,
      "description": "delete 入参：{ids:[…]} 逻辑删除（body.deleted）；链上条目不动。",
      "properties": {
        "ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pin_request": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "description": "pin 入参：{id, pinned?}（缺省置顶；pinned:false 取消）。",
      "properties": {
        "id": { "type": "string" },
        "pinned": { "type": "boolean" }
      }
    },
    "edit_request": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": true,
      "description": "edit 入参：{id, text, meta?, weight?} 同 id 覆盖条目（保留链位置），重算 chunks / 向量并替换索引记录。",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  },
  "method_timeouts": {
    "memory.put": 600000,
    "memory.search": 600000,
    "memory.append": 600000,
    "memory.edit": 600000
  }
}
