{
  "title": "sandbox（隔离执行）",
  "description": "身份自述 / 数据契约：描述 sandbox 能力类三方法 exec / fsop / capabilities 的入参与结果形状。四档 fs/net 映射表不住本 schema（schema 出生即冻结），住本身份数据世代 body（bag.sandbox_tiers）；本插件服务不读投影，tier / workspace_root / caps / sandbox_tiers 全由调用方入口 term 随 bag 传入。",
  "type": "object",
  "additionalProperties": true,
  "method_timeouts": {
    "sandbox.exec": 130000,
    "sandbox.exec_poll": 130000,
    "sandbox.fsop": 60000
  },
  "properties": {
    "caps": {
      "type": "object",
      "description": "工具声明的能力与资源上限；本插件取「声明 ∩ 当前档范围」后强制。缺省回落当前档范围与资源缺省。",
      "additionalProperties": true,
      "properties": {
        "fs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "enum": ["full", "workspace", "none"] },
            "write": { "enum": ["full", "workspace", "none"] }
          }
        },
        "net": { "enum": ["none", "limited", "all", "unset"] },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "mem_mb": { "type": "integer", "minimum": 0 },
        "cpu_ms": { "type": "integer", "minimum": 0 },
        "output_max": { "type": "integer", "minimum": 1 },
        "procs_max": { "type": "integer", "minimum": 0 }
      }
    },
    "grant": {
      "type": "object",
      "description": "批准后一次性放行凭据（不进世界，绑定 call_id、校验档位 / 范围后消费一次）。",
      "required": ["call_id"],
      "additionalProperties": true,
      "properties": {
        "call_id": { "type": "string" },
        "tier": { "enum": ["auto", "severe", "review", "deny"] },
        "expires": { "type": "number" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "net": { "enum": ["none", "limited", "all"] }
      }
    },
    "exec_request": {
      "type": "object",
      "description": "exec 的 bag：cmd + args + env；cwd 缺省 = bag.workspace_root，给出时须落在工作区内（区外须当前档 fs 读范围为 full）。",
      "required": ["cmd"],
      "additionalProperties": true,
      "properties": {
        "cmd": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object" },
        "cwd": { "type": "string" },
        "tier": { "enum": ["auto", "severe", "review", "deny"] },
        "workspace_root": { "type": "string" },
        "sandbox_tiers": { "type": "object" }
      }
    },
    "exec_result": {
      "type": "object",
      "description": "exec 结果；code 仅在超时 / 超限被杀时出现。truncated 时文本为「头 … 省略标记 … 尾」，omitted_bytes 为丢弃字节数。",
      "required": ["exit_code", "stdout", "stderr", "truncated", "duration_ms"],
      "additionalProperties": false,
      "properties": {
        "exit_code": { "type": ["integer", "null"] },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "truncated": { "type": "boolean" },
        "omitted_bytes": { "type": "integer", "minimum": 0 },
        "combined": {
          "type": "array",
          "description": "按到达顺序合并的 stdout / stderr 分块（保交错）。",
          "items": {
            "type": "object",
            "required": ["stream", "text"],
            "properties": {
              "stream": { "enum": ["stdout", "stderr"] },
              "text": { "type": "string" }
            }
          }
        },
        "combined_truncated": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "code": { "enum": ["timeout", "oom", "cpu_exceeded", "procs_max", "null"] }
      }
    },
    "session_request": {
      "type": "object",
      "description": "会话命令的 bag：session_id + command（原始命令串）；首次创建会话时另带 session_shell {cmd, args, syntax}。命令在常驻 shell 内执行，cd / env 跨命令延续（进程内存活对象，不落世界、不跨宿主重启）。",
      "required": ["session_id", "command"],
      "additionalProperties": true,
      "properties": {
        "session_id": { "type": "string" },
        "command": { "type": "string" },
        "session_shell": {
          "type": "object",
          "required": ["cmd", "args"],
          "properties": {
            "cmd": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "syntax": { "enum": ["powershell", "posix"] }
          }
        },
        "cwd": { "type": "string" },
        "env": { "type": "object" },
        "tier": { "enum": ["auto", "severe", "review", "deny"] },
        "workspace_root": { "type": "string" },
        "sandbox_tiers": { "type": "object" }
      }
    },
    "exec_start_result": {
      "type": "object",
      "description": "exec_start 结果：任务号，供 exec_poll / exec_kill 使用。",
      "required": ["task_id"],
      "additionalProperties": false,
      "properties": { "task_id": { "type": "string" } }
    },
    "exec_poll_request": {
      "type": "object",
      "description": "exec_poll：自 cursor（字节偏移）起取新输出；wait_ms>0 时最多等这么久等新数据或结束。",
      "required": ["task_id"],
      "additionalProperties": true,
      "properties": {
        "task_id": { "type": "string" },
        "cursor": { "type": "integer", "minimum": 0 },
        "wait_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "exec_poll_result": {
      "type": "object",
      "description": "exec_poll 结果：新输出文本 + 新游标 + 运行态 / 退出码 / 截断计数。",
      "required": ["output", "next_cursor", "running"],
      "additionalProperties": true,
      "properties": {
        "output": { "type": "string" },
        "next_cursor": { "type": "integer", "minimum": 0 },
        "running": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "code": { "type": ["string", "null"] },
        "truncated": { "type": "boolean" },
        "dropped_bytes": { "type": "integer", "minimum": 0 },
        "tail": { "type": "string" }
      }
    },
    "exec_kill_request": {
      "type": "object",
      "description": "exec_kill：杀任务（一次性进程杀整树；会话命令杀会话）。",
      "required": ["task_id"],
      "additionalProperties": true,
      "properties": { "task_id": { "type": "string" } }
    },
    "session_close_request": {
      "type": "object",
      "description": "session_close：关闭并回收一个会话。",
      "required": ["session_id"],
      "additionalProperties": true,
      "properties": { "session_id": { "type": "string" } }
    },
    "fsop_request": {
      "type": "object",
      "description": "fsop 的 bag：op + path + args（逐 op 参数）+ caps / tier / workspace_root / sandbox_tiers / grant。",
      "required": ["op", "path"],
      "additionalProperties": true,
      "properties": {
        "op": { "enum": ["stat", "read", "list", "grep", "write", "replace"] },
        "path": { "type": "string" },
        "args": { "type": "object" },
        "tier": { "enum": ["auto", "severe", "review", "deny"] },
        "workspace_root": { "type": "string" },
        "sandbox_tiers": { "type": "object" }
      }
    },
    "fsop_result": {
      "type": "object",
      "description": "fsop 结果：成功 {ok:true, op, result}，失败 {ok:false, code, message}。",
      "required": ["ok"],
      "additionalProperties": true,
      "properties": {
        "ok": { "type": "boolean" },
        "op": { "type": "string" },
        "result": { "type": "object" },
        "code": {
          "enum": [
            "bad_path",
            "bad_args",
            "path_not_found",
            "not_a_directory",
            "not_a_file",
            "edit_conflict",
            "too_large",
            "binary_unsupported",
            "fs_denied",
            "io_error",
            "sandbox_setup_failed"
          ]
        },
        "message": { "type": "string" }
      }
    },
    "capabilities_result": {
      "type": "object",
      "description": "capabilities 自述：本机可用实现与平台能力。",
      "required": ["platform", "implementations", "default_impl", "enforcement"],
      "additionalProperties": true,
      "properties": {
        "platform": { "type": "string" },
        "implementations": { "type": "array", "items": { "type": "object" } },
        "default_impl": { "type": "string" },
        "enforcement": { "type": "object" },
        "linux": {
          "type": ["object", "null"],
          "description": "Linux 隔离层运行态明细 {landlock_abi,cgroup_v2,seccomp,namespaces}；namespaces 为实际施加的种类数组（不含 pid）；非 Linux 为 null。"
        }
      }
    }
  }
}
